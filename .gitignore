
__pycache__/
*.pyc

# middleware venv (created by scripts/verify-local.sh; never committed)
services/middleware/.venv/
__pycache__/
*.egg-info/
# ...except inside the vendored SDK evidence snapshot. An sdist ships its own .egg-info, so
# those files are part of the published artifact and are recorded in MANIFEST.sha256. Ignoring
# them made the byte-identical gate pass locally (where the sdists had been unpacked) and fail
# in every fresh clone, which is the wrong way round for a gate.
!review/_sdk_src/**/*.egg-info/
.pytest_cache/
.ruff_cache/
