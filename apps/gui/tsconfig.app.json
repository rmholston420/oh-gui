{
  // Browser code ONLY. Node types are deliberately absent: `process`, `fs` and friends
  // must not typecheck in code that ships to a browser.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // `src/__tests__` is excluded here and checked by tsconfig.node.json instead:
  // tests there legitimately read fixtures through `node:fs`, while shipped
  // browser code still must not. Tests living beside their source are still
  // checked here, so this does not weaken the browser-purity guarantee.
  "exclude": ["src/__tests__"]
}
